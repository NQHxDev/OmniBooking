{
   "name": "client-monorepo",
   "version": "1.0.0",
   "private": true,
   "workspaces": [
      "apps/web",
      "apps/partner",
      "apps/owner",
      "packages/shared"
   ],
   "scripts": {
      "dev:web": "npm run dev --workspace=apps/web",
      "dev:partner": "npm run dev --workspace=apps/partner",
      "dev:owner": "npm run dev --workspace=apps/owner",
      "build:web": "NODE_ENV=production npm run build --workspace=apps/web",
      "build:partner": "NODE_ENV=production npm run build --workspace=apps/partner",
      "build:owner": "NODE_ENV=production npm run build --workspace=apps/owner",
      "build": "npm run build:web && npm run build:partner && npm run build:owner",
      "lint:web": "npm run lint --workspace=apps/web",
      "lint:partner": "npm run lint --workspace=apps/partner",
      "lint:owner": "npm run lint --workspace=apps/owner",
      "lint": "npm run lint:web && npm run lint:partner && npm run lint:owner"
   }
}
