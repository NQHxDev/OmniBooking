# Docker Compose Project Name
COMPOSE_PROJECT_NAME=omnibooking-prod

# Database Configuration
DB_NAME=omnibooking
DB_USER=zeion
DB_PASSWORD=your_production_db_password

# Redis Configuration
REDIS_PORT=6379

# Elasticsearch Configuration
ES_PORT=9200

# Backend Configuration
SERVER_PORT=8080
APP_BASE_URL=https://your-domain.com

# Frontend Configuration
CLIENT_PORT=3000
NEXT_PUBLIC_API_URL=https://your-domain.com/api/v1/
NEXT_PUBLIC_WEB_URL=https://your-domain.com
NEXT_PUBLIC_PARTNER_URL=https://partner.your-domain.com
NEXT_PUBLIC_OWNER_URL=https://owner.your-domain.com
COOKIE_DOMAIN=.your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://partner.your-domain.com,https://owner.your-domain.com

# Map Configuration
NEXT_PUBLIC_VIETMAP_API_KEY=your_vietmap_api_key
NEXT_PUBLIC_VIETMAP_TILE_KEY=your_vietmap_tile_key
NEXT_PUBLIC_GOONG_API_KEY=your_goong_api_key
NEXT_PUBLIC_GOONG_MAPTILES_KEY=your_goong_maptiles_key

# Security Configuration
JWT_SECRET=your_jwt_secret_min_32_chars
ENCRYPTION_SECRET=your_32_char_encryption_secret_here
ENCRYPTION_KEY_AES_V1=your_aes_v1_key_hex_string_here
HASH_PEPPER=your_random_hash_pepper_here
CSRF_SECRET=your_32_char_csrf_secret_here

# Email Configuration
RESEND_API_KEY=your_resend_api_key
MAIL_FROM=OmniBooking <no-reply@yourdomain.com>

# Environment Configuration
NODE_ENV=production
COOKIE_SECURE=true

# Kafka Scaling
KAFKA_PARTITIONS=3
KAFKA_REPLICAS=1

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google OAuth2 Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-domain.com/api/v1/auth/google/callback
FRONTEND_AUTH_CALLBACK_URL=https://your-domain.com/auth/callback

# Zalo OAuth2 Configuration
ZALO_CLIENT_ID=your_zalo_app_id
ZALO_CLIENT_SECRET=your_zalo_app_secret
ZALO_REDIRECT_URI=https://your-domain.com/api/v1/auth/zalo/callback
ZALO_FRONTEND_CALLBACK_URL=https://your-domain.com/auth/callback

# Currency Exchange API Configuration
APP_CURRENCY_API_KEY=your_api_key_here

# WebAuthn (Passkey) Configuration
WEBAUTHN_RP_ID=your-domain.com
WEBAUTHN_RP_NAME=OmniBooking
WEBAUTHN_ORIGIN=https://your-domain.com

# Cloudflare Turnstile Configuration
TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key

# Cloudflare Tunnel Configuration
TUNNEL_TOKEN=your_cloudflare_tunnel_token

# Sentry Observability
SENTRY_DSN_SERVER=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2
APP_VERSION=0.1.0

# Client Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Seeding Configuration
APP_SEEDING_ENABLED=false
