# Database Configuration
DB_NAME=omnibooking
DB_USER=zeion
DB_PASSWORD=your_db_password

# Redis Configuration
REDIS_PORT=6379

# Elasticsearch Configuration
ES_PORT=9200

# Backend Configuration
SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080

# Frontend Configuration
CLIENT_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_PARTNER_URL=http://localhost:3002
NEXT_PUBLIC_OWNER_URL=http://localhost:3005
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3005

# Map Configuration
NEXT_PUBLIC_VIETMAP_API_KEY=your_vietmap_api_key
NEXT_PUBLIC_VIETMAP_TILE_KEY=your_vietmap_tile_key
NEXT_PUBLIC_GOONG_API_KEY=your_goong_api_key
NEXT_PUBLIC_GOONG_MAPTILES_KEY=your_goong_maptiles_key

# Security Configuration
JWT_SECRET=your_jwt_secret_min_32_chars
ENCRYPTION_SECRET=your_32_char_encryption_secret_here
ENCRYPTION_KEY_AES_V1=your_aes_v1_key_hex_string_here
HASH_PEPPER=your_random_hash_pepper_here
CSRF_SECRET=your_32_char_csrf_secret_here

# Email Configuration
RESEND_API_KEY=your_resend_api_key
MAIL_FROM=OmniBooking <no-reply@yourdomain.com>

# Environment Configuration
NODE_ENV=development
COOKIE_SECURE=false

# Kafka Scaling
KAFKA_PARTITIONS=3
KAFKA_REPLICAS=1

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google OAuth2 Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
FRONTEND_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# Zalo OAuth2 Configuration
ZALO_CLIENT_ID=your_zalo_app_id
ZALO_CLIENT_SECRET=your_zalo_app_secret
ZALO_REDIRECT_URI=http://localhost:8080/api/v1/auth/zalo/callback
ZALO_FRONTEND_CALLBACK_URL=http://localhost:3000/auth/callback

# Currency Exchange API Configuration
APP_CURRENCY_API_KEY=your_api_key_here

# WebAuthn (Passkey) Configuration
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=OmniBooking
WEBAUTHN_ORIGIN=http://localhost:3000

# Cloudflare Turnstile Configuration
TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key

# Sentry Observability
SENTRY_DSN_SERVER=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
APP_VERSION=0.1.0

# Client Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
