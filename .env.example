# Database Configuration
DB_NAME=omnibooking
DB_USER=zeion
DB_PASSWORD=your_db_password

# Redis Configuration
REDIS_PORT=6379

# Elasticsearch Configuration
ES_PORT=9200

# Backend Configuration
SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080

# Frontend Configuration
CLIENT_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Security Configuration
JWT_SECRET=your_jwt_secret_min_32_chars

# Email Configuration
RESEND_API_KEY=your_resend_api_key
MAIL_FROM=OmniBooking <no-reply@yourdomain.com>

# Environment Configuration
NODE_ENV=development
COOKIE_SECURE=false

# Kafka Scaling
KAFKA_PARTITIONS=3
KAFKA_REPLICAS=1

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google OAuth2 Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
FRONTEND_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# Zalo OAuth2 Configuration
ZALO_CLIENT_ID=your_zalo_app_id
ZALO_CLIENT_SECRET=your_zalo_app_secret
ZALO_REDIRECT_URI=http://localhost:8080/api/v1/auth/zalo/callback
ZALO_FRONTEND_CALLBACK_URL=http://localhost:3000/auth/callback
